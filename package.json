{
  "name": "private-hub",
  "private": true,
  "version": "0.0.0",
  "description": "Family Chat Hub — a private hub for one family: an AI assistant, an AI builder, a shared messenger with voice and video calls, a contacts roster, and a control room for your devices.",
  "type": "module",
  "scripts": {
    "dev": "sh ./scripts/dev.sh",
    "dev:web": "vite",
    "own": "bash self-hosting/own.sh",
    "self-host": "bash self-hosting/setup.sh",
    "bundle": "bash self-hosting/bundle.sh",
    "restore": "bash self-hosting/restore.sh",
    "build": "tsc -b && vite build",
    "build:local": "VITE_PROFILE=local sh -c 'tsc -b && vite build'",
    "lint": "eslint .",
    "icons": "bun scripts/make-icons.mjs",
    "host": "bun native/main.ts",
    "host:diagnostics": "bun native/main.ts --diagnostics",
    "relay": "bun native/relay.ts",
    "selfcheck": "bun native/selfcheck.ts",
    "check:native": "tsc -p native/tsconfig.json --noEmit",
    "os": "bun os/main.ts",
    "os:audit": "bun os/main.ts --audit",
    "os:diagnostics": "bun os/main.ts --diagnostics",
    "check:os": "tsc -p os/tsconfig.json --noEmit",
    "test:os": "bun os/tests/run.ts",
    "browser:install": "cd sugar-browser && npm install",
    "browser": "cd sugar-browser && npm start",
    "browser:portable": "cd sugar-browser && npm run start:portable",
    "browser:test": "cd sugar-browser && node tests/run.js",
    "browser:check": "node --check sugar-browser/main.js && node --check sugar-browser/preload.js && node --check sugar-browser/ui/app.js && node --check sugar-browser/src/portable.js && node --check sugar-browser/src/store.js && node --check sugar-browser/src/security.js && node --check sugar-browser/src/updates.js && node --check sugar-browser/src/sugar-controller.js && node --check sugar-browser/src/ai/sugar.js && node --check sugar-browser/src/ai/providers.js && node sugar-browser/tests/run.js",
    "browser:dist": "cd sugar-browser && npm run dist",
    "snapshot:self": "bun scripts/snapshot-self.mjs",
    "snapshot:app": "bun scripts/pack-this-app.mjs",
    "verify:self": "bun scripts/verify-self.mjs",
    "test:relay": "bun scripts/relay-check.ts",
    "test:hub": "bun scripts/hub-ai-check.ts",
    "test:builder": "bun scripts/builder-agent-check.ts",
    "test:this-app": "bun scripts/this-app-check.ts",
    "test:companion": "bun scripts/companion-check.ts",
    "test:access": "bun scripts/access-check.ts",
    "test:browser": "bun scripts/browser-check.ts",
    "test:voice": "bun scripts/voice-check.ts",
    "test:calls": "bun scripts/call-check.ts",
    "format": "prettier --write .",
    "preview": "vite preview",
    "test:auth": "bun scripts/auth-check.ts"
  },
  "dependencies": {
    "@convex-dev/auth": "^0.0.90",
    "@hookform/resolvers": "^5.9.1",
    "@jridgewell/trace-mapping": "^0.3.31",
    "@monaco-editor/react": "^4.7.0",
    "@oslojs/crypto": "^1.0.1",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-aspect-ratio": "^1.2.0",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-hover-card": "^1.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-menubar": "^1.2.1",
    "@radix-ui/react-navigation-menu": "^1.4.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toggle": "^1.2.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tailwindcss/vite": "^4.3.3",
    "@webcontainer/api": "^1.6.4",
    "@zumer/snapdom": "^2.24.18",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "convex": "^1.46.0",
    "date-fns": "^4.4.0",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "dictionary-en": "^4.0.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.43.0",
    "hono": "^4.13.13",
    "input-otp": "^1.5.0",
    "livekit-client": "^2.22.4",
    "lucide-react": "^0.555.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-day-picker": "9.13.0",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "react-intersection-observer": "^10.1.0",
    "react-resizable-panels": "^3.0.6",
    "react-router": "^7.18.4",
    "recharts": "^2.15.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "vaul": "^1.1.2",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "@vly-ai/integrations": "^0.6.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "prettier": "3.7.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.3.7"
  }
}
