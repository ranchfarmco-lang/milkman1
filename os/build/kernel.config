# NOVA OS kernel configuration fragment.
#
# This is applied on top of `make defconfig` for the Linux 6.12 series, then
# built with:
#
#   make defconfig
#   scripts/kconfig/merge_config.sh .config os/build/kernel.config
#   make -j"$(nproc)"
#
# It enables exactly what the OS's components need at the kernel boundary, and
# nothing that a general-purpose desktop distribution would carry. Every option
# below maps to a component that is written and tested in os/:

CONFIG_64BIT=y
CONFIG_SMP=y
CONFIG_PREEMPT_VOLUNTARY=y

# --- init and containers -----------------------------------------------------
# initramfs hand-off, and the namespaces the application runtime uses.
CONFIG_BLK_DEV_INITRD=y
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_PIDS=y
CONFIG_MEMCG=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# --- the network stack (os/net/manager.ts) -----------------------------------
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_NETFILTER=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NF_CONNTRACK=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP6_NF_FILTER=y

# --- the VPN subsystem (os/net/vpn.ts) ---------------------------------------
CONFIG_WIREGUARD=y
CONFIG_XFRM_USER=y
CONFIG_INET_ESP=y

# --- storage (os/core/runtime.ts) --------------------------------------------
# btrfs is the root filesystem so whole-system snapshots are a filesystem
# feature (os/ai/snapshots.ts names this as its fallback).
CONFIG_BTRFS_FS=y
CONFIG_BTRFS_FS_POSIX_ACL=y
CONFIG_EXT4_FS=y
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# --- devices the OS discovers (os/comms/engine.ts) ---------------------------
CONFIG_VIDEO_DEV=y
CONFIG_SND=y
CONFIG_SND_USB_AUDIO=y
CONFIG_USB=y
CONFIG_INPUT_EVDEV=y

# --- Ethernet and Wi-Fi ------------------------------------------------------
CONFIG_NETDEVICES=y
CONFIG_E1000=y
CONFIG_E1000E=y
CONFIG_VIRTIO_NET=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_ATH9K=m
CONFIG_IWLWIFI=m

# --- EFI so the image boots on real hardware --------------------------------
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_PARTITION=y
