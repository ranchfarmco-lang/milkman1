node_modules
dist
src/convex/_generated

# Python bytecode: the local brain (public/offline-brain/brain) is Python, so a
# run of it or of its test suite leaves these behind.
__pycache__/
*.pyc

# Keys and tokens never belong in the repo. The example file stays, so the
# setup is still documented without any real values.
.env
.env.*
!.env.example

# Local-only state: which Convex deployment this machine is pointed at, the
# local backend's own data directory (files, modules, exports — eleven
# megabytes of this machine's storage, with no database to read it back), and
# the platform's own run logs.
.convex
convex_local_storage
.vly-run

# The independent bundle `self-hosting/bundle.sh` writes: a runtime, a backend
# program and an installed node_modules, made to be copied somewhere else rather
# than kept here. Hundreds of megabytes, all of it reproducible from this tree.
dist-independent

# A vendored copy of someone else's source tree (~81 MB, including ripgrep
# binaries and a 18 MB tarball) that the offline brain documents. It is a
# reference, not this app's code, and it is far too large — and too unrelated —
# to keep in this repository. `public/offline-brain/` is the part that ships:
# it carries the archive below, which is packed from this tree by
# `bun scripts/pack-freebuff-source.mjs`.
offline-ai-coding-brain

# Generated downloads of the source tree — what saving this project produces
# rather than what it is made of. The `.zip` line matters as much as the other:
# an archive left in the project root is otherwise packed into the next archive,
# and the one after that, which is how a 21 MB save becomes a 42 MB save.
*.tar.gz
*.zip

# ...except the two archives the app actually serves. They sit inside the
# offline brain package, every download on the Offline Brain page carries them,
# the installer unpacks both, and `bun run test:this-app` reads them out of
# `public/` — so a downloaded or freshly cloned copy is complete and fetches
# nothing. Both have to be named: a `.zip` that is not negated is not saved, and
# a repository missing the app's own archive is not this app.
!public/offline-brain/source/freebuff-source.zip
!public/offline-brain/source/this-app-source.zip
.vercel
.env*
